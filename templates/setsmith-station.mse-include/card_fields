		image: { "/setsmith-station.mse-include/band-" + station_color() + "2.png" }
	# The round "N+" badge, its rim in the card's colour.
	station badge 1:
		left: 10
		top: { station_top(1) + station_h(1) / 2 - 14 }
		width: 29.5
		height: 29.5
