extra card style:
	# Bonus Stage theme: a torn salmon brush swatch behind a Character's name, sized from the name's estimated length.
	name banner:
		left: { bleed_x + 22 }
		top: { bleed_y + char_name_bottom() - char_brush_height() + 12 }
		width: { char_brush_width() }
		height: { char_brush_height() }
		z index: 5
		render style: image
		visible: { is_char() and bonus_theme() }
		image: { common + "bonus-brush.png" }
	keyword strip:
		left: { bleed_x + 22 }
		top: { bleed_y + 648 }
		width: 700
		height: 40
		z index: 2
		render style: image
		visible: { has_keyword_line() and not is_char() }
		image: { common + "strip-" + card.card_type + ".png" }
	# Non-characters: in the keyword strip. Characters: under the name, on the art.
	keyword line:
		left: { bleed_x + (if is_char() then 50 else 64) }
		top: { bleed_y + (if is_char() then char_rules_top() - 37 else 651) }
		width: { if is_char() then 540 else 620 }
		height: { if is_char() then 32 else 37 }
		z index: 5
		alignment: middle left
		visible: { has_keyword_line() }
		font:
			name: Figtree ExtraBold
			style: italic
			size: 15
			color: white
			stroke color: { if is_char() then rgb(0,0,0) else rgba(0,0,0,0) }
			stroke width: 3
			shadow color: { if is_char() then rgba(0,0,0,200) else rgba(0,0,0,0) }
			shadow displacement x: 2
			shadow displacement y: 2.5
	# The set's IP logo, faint, behind the rules text (Set info: watermark).
	watermark:
		left: { bleed_x + (if is_char() then 208 else 262) }
		top: { bleed_y + (if is_char() then 690 else 704) }
		width: 220
		height: 220
		z index: 3
		render style: image
		# not on Characters: official ones have none, and over full art it reads as a smudge
		visible: { set.watermark == "ip logo" and not is_char() }
		image: { set_alpha(set.ip_logo, alpha: 0.14) }
	difficulty rim:
		left: { bleed_x + 26 }
		top: { bleed_y + 22 }
		width: 126
		height: 130
		z index: 6
		render style: image
		visible: { not is_char() }
		image: { number_rim(value: card.difficulty) }
	difficulty image:
		left: { bleed_x + 26 }
		top: { bleed_y + 22 }
		width: 126
		height: 130
		z index: 7
		render style: image
		visible: { not is_char() }
		image: { number_image(value: card.difficulty, kind: "d") }
	check rim:
		left: { bleed_x + 596 }
		top: { bleed_y + 826 }
		width: 126
		height: 130
		z index: 6
		render style: image
		visible: { not is_char() }
		image: { number_rim(value: card.check) }
	check image:
		left: { bleed_x + 596 }
		top: { bleed_y + 826 }
		width: 126
		height: 130
		z index: 7
		render style: image
		visible: { not is_char() }
		image: { number_image(value: card.check, kind: "c") }
	block rim:
		left: { bleed_x + 606 }
		top: { bleed_y + 28 }
		width: 116
		height: 100
		z index: 6
		render style: image
		visible: { card.block != "" and not is_char() }
		image: { recolor_image(common + "shield-rim.png", color: type_color()) }
	speed rim:
		left: { bleed_x + 599 }
		top: { bleed_y + 601 }
		width: 116
		height: 100
		z index: 6
		render style: image
		visible: { card.card_type == "attack" }
		image: { recolor_image(common + "speed-rim.png", color: type_color()) }
	damage rim:
		left: { bleed_x + 591 }
		top: { bleed_y + 701 }
		width: 116
		height: 100
		z index: 6
		render style: image
		visible: { card.card_type == "attack" }
		image: { recolor_image(common + "damage-rim.png", color: type_color()) }
	damage image:
		left: { bleed_x + 591 }
		top: { bleed_y + 701 }
		width: 116
		height: 100
		z index: 7
		render style: image
		visible: { card.card_type == "attack" }
		image: { common + "damage.png" }
	# Backup stamina (green) and Character health (red) share the heart shape; 139 x 120 = the measured 110 x 90 heart.
	heart rim:
		left: { bleed_x + (if is_char() then 590 else 585) }
		top: { bleed_y + (if is_char() then 703 else 713) }
		width: 139
		height: 120
		z index: 6
		render style: image
		visible: { is_char() or card.card_type == "backup" }
		image: { recolor_image(common + "heart-rim.png", color: type_color()) }
	heart image:
		left: { bleed_x + (if is_char() then 590 else 585) }
		top: { bleed_y + (if is_char() then 703 else 713) }
		width: 139
		height: 120
		z index: 7
		render style: image
		visible: { is_char() or card.card_type == "backup" }
		image: { common + (if is_char() then "heart-health.png" else "heart-stamina.png") }
	hand size rim:
		left: { bleed_x + 596 }
		top: { bleed_y + 578 }
		width: 116
		height: 112
		z index: 6
		render style: image
		visible: { is_char() }
		image: { recolor_image(common + "hand-size-rim.png", color: type_color()) }
	hand size image:
		left: { bleed_x + 596 }
		top: { bleed_y + 578 }
		width: 116
		height: 112
		z index: 7
		render style: image
		visible: { is_char() }
		image: { common + "hand-size.png" }
	ip logo:
		left: { bleed_x + 47 }
		top: { bleed_y + 967 }
		width: 60
		height: 42
		z index: 3
		render style: image
		image: { common + "logo-ring.png" }
	# The set's IP logo (Set info), fitted in a 28-unit box centered in the ring, as on FT01 cards.
	# Clipped to the ring's inside; with no logo it is just black.
	ip logo image:
		left: { bleed_x + 53.75 }
		top: { bleed_y + 973.75 }
		width: 28
		height: 28
		z index: 4
		render style: image
		image: { set_mask(image: set.ip_logo, mask: common + "logo-mask.png") }
	footer line:
		left: { bleed_x + 300 }
		top: { bleed_y + 967 }
		width: 408
		height: 24
		z index: 3
		alignment: middle right
		font:
			name: Figtree SemiBold
			size: 11.8
			color: white
	copyright line:
		left: { bleed_x + 300 }
		top: { bleed_y + 990 }
		width: 408
		height: 21
		z index: 3
		alignment: middle right
		font:
			name: Figtree SemiBold
			size: 9
			color: white
