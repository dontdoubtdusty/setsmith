# Field layout for the UniVersus 2026 frame, shared by the bleed, exact-size and MPC stylesheets.
# Units: exact card units (744 x 1039 = 2.5 x 3.5 in at 300 dpi). Positions add "bleed_x" (left, width) or "bleed_y" (top, height).
# Measured from official 1488 x 2079 and 744 x 1039 card images (FT01, TK802, GDZ01, SL).
#
# Types: Foundation, Action, Asset have a colored text box; Backup adds a stamina heart and Attack adds
# speed + damage, both stacked on the right above the check. Characters have no text box: full art to the card
# edge (and the bleed), with a backing set by the Set info "character theme", the name, traits and rules text
# on it, and hand size + health.

card background: black

# Set info: the IP logo box. Its size is also the size the logo is stored at (square, 256 px keeps it sharp in print).
set info style:
	ip logo:
		width: 256
		height: 256

############################################################## Card fields

card style:
	############################# Art and frame
	# Characters: full art over the whole card and the bleed (art for print: the stylesheet card size, for example 819 x 1114 or 822 x 1122 for MPC).
	image:
		left: { if is_char() then 0 else bleed_x + 22 }
		top: { if is_char() then 0 else bleed_y + 22 }
		width: { if is_char() then 744 + 2 * bleed_x else 700 }
		height: { if is_char() then 1039 + 2 * bleed_y else 700 }
		z index: 0
		mask: { if is_char() then common + "mask-white.png" else common + "art-mask.png" }
	# Characters: the cut-out character over the art and its shading, below the text.
	cutout:
		left: 0
		top: 0
		width: { 744 + 2 * bleed_x }
		height: { 1039 + 2 * bleed_y }
		z index: 2
		visible: { is_char() }
		mask: { common + "mask-white.png" }
	# Characters: no text box, as on the official cards; a light scrim over the bottom left of the art.
	card type:
		left: { if is_char() then 0 else bleed_x + 22 }
		top: { if is_char() then 0 else bleed_y + 648 }
		width: { if is_char() then 744 + 2 * bleed_x else 700 }
		height: { if is_char() then 1039 + 2 * bleed_y else 297 }
		z index: 1
		render style: image
		image: { common + (if is_char() then "shade-character" else "box-" + card.card_type) + ".png" }

	############################# Name and keyword line
	name:
		left: { bleed_x + 44 }
		top: { bleed_y + (if is_char() then char_name_bottom() - 158 else 500) }
		width: { if is_char() then 540 else 640 }
		height: 158
		z index: 6
		alignment: bottom left
		line height soft: 0.78
		font:
			name: Figtree Black
			style: italic
			size: 37
			color: white
			stroke color: black
			stroke width: 5
			stroke2 color: { type_color() }
			stroke2 width: 4
			shadow color: { if is_char() then rgba(0,0,0,190) else rgba(0,0,0,0) }
			shadow displacement x: 3
			shadow displacement y: 4
	keywords:
		visible: false
	separator:
		visible: false
	traits:
		visible: false

	############################# Rules text
	rule text:
		left: { bleed_x + 46 }
		top: { bleed_y + (if is_char() then char_rules_top() else rules_top()) }
		width: { if is_char() then 544 else 660 }
		height: { if is_char() then 936 - char_rules_top() else 940 - rules_top() }
		z index: 4
		alignment: { if is_char() then "top left" else "middle left" }
		mask: { if is_char() then common + "rules-mask-full.png" else rules_mask() }
		line height soft: 0.78
		line height hard: 1.1
		padding right: 6
		font:
			name: Barlow Condensed SemiBold
			size: 25.5
			color: white
			# Characters: a heavy outline and a hard drop shadow so the text reads on any art
			stroke color: { if is_char() then rgb(0,0,0) else rgba(0,0,0,0) }
			stroke width: 3
			shadow color: { if is_char() then rgba(0,0,0,200) else rgba(0,0,0,0) }
			shadow displacement x: 2
			shadow displacement y: 3
		symbol font:
			name: uvs-symbols
			size: 25
			alignment: middle center

	############################# Big numbers (the images are drawn by extra fields below)
	difficulty:
		left: { bleed_x + 26 }
		top: { bleed_y + 22 }
		width: 126
		height: 130
		z index: 8
		visible: { not is_char() }
		alignment: middle center
		font:
			name: Figtree Black
			style: italic
			size: 66
			color: { if glyph_id(card.difficulty) == "" then rgb(255,150,30) else rgba(0,0,0,0) }
			stroke color: { if glyph_id(card.difficulty) == "" then rgb(0,0,0) else rgba(0,0,0,0) }
			stroke width: 6
			stroke2 color: { if glyph_id(card.difficulty) == "" then type_color() else rgba(0,0,0,0) }
			stroke2 width: 5
	check:
		left: { bleed_x + 596 }
		top: { bleed_y + 826 }
		width: 126
		height: 130
		z index: 8
		visible: { not is_char() }
		alignment: middle center
		font:
			name: Figtree Black
			style: italic
			size: 66
			color: { if glyph_id(card.check) == "" then rgb(40,160,230) else rgba(0,0,0,0) }
			stroke color: { if glyph_id(card.check) == "" then rgb(0,0,0) else rgba(0,0,0,0) }
			stroke width: 6
			stroke2 color: { if glyph_id(card.check) == "" then type_color() else rgba(0,0,0,0) }
			stroke2 width: 5

	############################# Block
	block zone:
		left: { bleed_x + 606 }
		top: { bleed_y + 28 }
		width: 116
		height: 100
		z index: 7
		render style: image
		visible: { card.block != "" and not is_char() }
		image: { common + "shield-" + card.block_zone + ".png" }
	block:
		left: { bleed_x + 616 }
		top: { bleed_y + 42 }
		width: 74
		height: 62
		z index: 9
		visible: { not is_char() }
		alignment: middle center
		font:
			name: Figtree Black
			size: 38
			color: white
			stroke color: black
			stroke width: 3.2

	############################# Stat stack: Attack (speed, damage), Backup (stamina), Character (hand size, health)
	# Positions measured on SL Bear Bite (Attack), TK802-041 (Backup) and FT01-006 (Character).
	attack zone:
		left: { bleed_x + 599 }
		top: { bleed_y + 601 }
		width: 116
		height: 100
		z index: 7
		render style: image
		visible: { card.card_type == "attack" }
		image: { common + "speed-" + card.attack_zone + ".png" }
	speed:
		left: { bleed_x + 619 }
		top: { bleed_y + 626 }
		width: 70
		height: 50
		z index: 9
		visible: { card.card_type == "attack" }
		alignment: middle center
		font:
			name: Figtree Black
			size: 40
			color: white
			stroke color: black
			stroke width: 3.5
	damage:
		left: { bleed_x + 609 }
		top: { bleed_y + 726 }
		width: 80
		height: 50
		z index: 9
		visible: { card.card_type == "attack" }
		alignment: middle center
		font:
			name: Figtree Black
			size: 40
			color: white
			stroke color: black
			stroke width: 3.5
	stamina:
		left: { bleed_x + 615 }
		top: { bleed_y + 739 }
		width: 80
		height: 52
		z index: 9
		visible: { card.card_type == "backup" }
		alignment: middle center
		font:
			name: Figtree Black
			size: 40
			color: white
			stroke color: black
			stroke width: 3.5
	hand size:
		left: { bleed_x + 625 }
		top: { bleed_y + 612 }
		width: 70
		height: 56
		z index: 9
		visible: { is_char() }
		alignment: middle center
		font:
			name: Figtree Black
			size: 42
			color: white
			stroke color: black
			stroke width: 3.5
	health:
		left: { bleed_x + 620 }
		top: { bleed_y + 733 }
		width: 80
		height: 52
		z index: 9
		visible: { is_char() }
		alignment: middle center
		font:
			name: Figtree Black
			size: 42
			color: white
			stroke color: black
			stroke width: 3.5

	############################# Footer
	# Resource symbols, measured on FT01 2x scans: centered at y 988.25, 47.5 apart, first at x 135.75.
	# Each image is 41 units (attuned square 41, circle 40 with its white halo).
	symbol 1:
		left: { bleed_x + 115.25 }
		top: { bleed_y + 967.75 }
		width: 41
		height: 41
		z index: 3
		render style: image
		image: { symbol_image(card.symbol_1) }
	symbol 2:
		left: { bleed_x + 162.75 }
		top: { bleed_y + 967.75 }
		width: 41
		height: 41
		z index: 3
		render style: image
		image: { symbol_image(card.symbol_2) }
	symbol 3:
		left: { bleed_x + 210.25 }
		top: { bleed_y + 967.75 }
		width: 41
		height: 41
		z index: 3
		render style: image
		image: { symbol_image(card.symbol_3) }
	symbol 4:
		left: { bleed_x + 257.75 }
		top: { bleed_y + 967.75 }
		width: 41
		height: 41
		z index: 3
		render style: image
		image: { symbol_image(card.symbol_4) }
	symbol 5:
		left: { bleed_x + 305.25 }
		top: { bleed_y + 967.75 }
		width: 41
		height: 41
		z index: 3
		render style: image
		image: { symbol_image(card.symbol_5) }
	symbol 6:
		left: { bleed_x + 352.75 }
		top: { bleed_y + 967.75 }
		width: 41
		height: 41
		z index: 3
		render style: image
		image: { symbol_image(card.symbol_6) }
	rarity:
		visible: false
	number:
		visible: false
	face:
		visible: false
	credit:
		visible: false

