############################################################## Station rows (Setsmith)
# Layout for the station fields in game_fields. Positions are in 375 x 523 frame units, measured from printed
# Star Trek Spacecraft (Borg Cube, Romulan Bird-of-Prey). Bands sit above the frame and below all text (z 850);
# the frame's own text box is shortened by station_height() (patched into each frame by tools\make-slim-data.ps1).
# Row text is set in the same size as the fitted rules text, like printed cards.
card style:
	station 1 threshold:
		left: 10
		top: { station_top(1) + station_h(1) / 2 - 14 }
		width: 29.5
		height: 29.5
		z index: 960
		visible: { card.station_1_threshold != "" }
		alignment: middle center shrink-overflow
		padding left: 2.4
		padding bottom: 2
		font:
			name: Beleren Bold
			size: { station_badge_size() }
			scale down to: 7
			color: white
	station 1 text:
		left: 40
		top: { station_top(1) }
		width: { if station_last() == 1 and card.pt != "" then 252 else 299 }
		height: { max(1, station_h(1)) }
		z index: 905
		visible: { card.station_1_threshold != "" }
		alignment: middle left
		padding left: 4
		padding right: 4
		padding bottom: 1
		font:
			name: MPlantin
			italic name: MPlantin-Italic
			size: { station_rules_size() * card_style.text.content_scale }
			scale down to: 6
			color: black
		symbol font:
			name: { styling.text_box_mana_symbols }
			size: { station_rules_size() * card_style.text.content_scale }
		line height hard: 1.128
		line height soft: { station_line_soft() }
	station 2 threshold:
		left: 10
		top: { station_top(2) + station_h(2) / 2 - 14 }
		width: 29.5
		height: 29.5
		z index: 960
		visible: { card.station_2_threshold != "" }
		alignment: middle center shrink-overflow
		padding left: 2.4
		padding bottom: 2
		font:
			name: Beleren Bold
			size: { station_badge_size() }
			scale down to: 7
			color: white
	station 2 text:
		left: 40
		top: { station_top(2) }
		width: { if card.pt != "" then 252 else 299 }
		height: { max(1, station_h(2)) }
		z index: 905
		visible: { card.station_2_threshold != "" }
		alignment: middle left
		padding left: 4
		padding right: 4
		padding bottom: 1
		font:
			name: MPlantin
			italic name: MPlantin-Italic
			size: { station_rules_size() * card_style.text.content_scale }
			scale down to: 6
			color: black
		symbol font:
			name: { styling.text_box_mana_symbols }
			size: { station_rules_size() * card_style.text.content_scale }
		line height hard: 1.128
		line height soft: { station_line_soft() }
extra card field:
