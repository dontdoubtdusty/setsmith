# MakePlayingCards poker-size template: 822 x 1122 px at 300 dpi (2.74 x 3.74 in).
# MPC trims to 750 x 1050 (2.5 x 3.5 in), 36 px in from each edge. The exact card (744 x 1039) sits
# centered, so the cut lands 3 px (sides) and 5.5 px (top, bottom) out in the bleed, never in the frame.
# The layout is shared with the bleed (uvs-2026) and exact-size (uvs-2026-exact) stylesheets.
card width: 822
card height: 1122
card dpi: 300

init script:
	bleed_x := 39
	bleed_y := 41.5
	include file: /uvs-2026-common.mse-include/scripts

include file: /uvs-2026-common.mse-include/card-style
